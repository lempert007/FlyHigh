# ─── FlyHigh Docker configuration ────────────────────────────────────────────
# Copy this file to .env and fill in your values before running docker compose.
#
# Usage:
#   cp .env.docker .env
#   docker compose --env-file .env up -d

# Port the app will be accessible on from the host browser
FRONTEND_PORT=3000

# Full tile URL template — used by Leaflet in the browser and by the backend for PDF rendering.
# Use {z}, {x}, {y} as placeholders (standard Leaflet/slippy-map format).
# Must be reachable from the browser (use an IP or hostname, not host.docker.internal).
#   TILE_SERVER_URL=http://192.168.1.100:8888/tiles/{z}/{x}/{y}.png
#   TILE_SERVER_URL=http://mymachine.local/wkt/something/{z}/{x}/{y}.png
TILE_SERVER_URL=http://192.168.1.100:8888/tiles/{z}/{x}/{y}.png

# Volume paths on the host (defaults shown — override if needed)
# MAPS_PATH=./maps
# MISSIONS_PATH=./missions
